// 4x4 matrix keyboard default keymap (numpad layout).
// See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp KP_DIVIDE
                &kp N4 &kp N5 &kp N6 &kp KP_MULTIPLY
                &kp N7 &kp N8 &kp N9 &kp KP_MINUS
                &kp KP_DOT &kp N0 &kp KP_PLUS &kp KP_ENTER
            >;
        };
    };
};
